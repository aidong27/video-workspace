APP_TITLE=Video Workspace
SERVICE_VERSION=1.2.0
WEB_CONCURRENCY=1
# Access: activation codes are the only way in. Issue the first (owner) code with
#   python -m app.access issue --owner --label 站长 --username <name>
# then issue codes for everyone else from /admin. Codes are stored as HMACs under
# a pepper kept next to the auth database (or ACCESS_CODE_PEPPER, 32+ chars).
AUTH_DB_PATH=./var/auth/auth.db
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
ACCESS_CODE_PEPPER=
# Signed-in browsers per person; the oldest is signed out beyond this.
ACCESS_MAX_DEVICES=3
ACCESS_OWNER_MAX_DEVICES=10
# Per member (the owner is unlimited); 0 means no daily limit.
MEMBER_DAILY_JOB_LIMIT=30
MEMBER_MAX_ACTIVE_JOBS=2
# Optional extra owner accounts by internal account name.
ADMIN_USERNAMES=
# The owner saves a Bilibili login by QR code in /admin; every Bilibili request
# then uses it. COOKIE_ENABLED=true would instead use the BILI_* values below.
COOKIE_ENABLED=false
# Minimum spacing between signed-in Bilibili API calls, to protect the account.
BILI_MIN_INTERVAL_SECONDS=0.8
BILI_COOKIE=
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=
BILI_COOKIE_PATH=./var/auth/bili-cookie.txt
# After Bilibili refuses this server (HTTP 412 / risk control), answer new Bilibili
# requests locally with a clear error for this many seconds instead of repeating them.
BILI_RISK_COOLDOWN_SECONDS=300
# The public WBI signing key rotates about daily; it is cached between requests.
BILI_WBI_KEY_TTL_SECONDS=1800
# Local ASR is the baseline service. Cloud ASR is an optional advanced mode
# and must be enabled only after filling the credentials and hard limits below.
CLOUD_ASR_ENABLED=false
LOCAL_ASR_ENABLED=true
ASR_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1
ASR_DEFAULT_MODEL=qwen3-asr-flash-filetrans
ASR_ECONOMY_MODEL=paraformer-v2
ASR_ALLOW_PAID=false
ASR_MONTHLY_FREE_SECONDS=0
ASR_MONTHLY_HARD_LIMIT_SECONDS=0
ASR_TOTAL_HARD_LIMIT_SECONDS=0
ASR_DAILY_HARD_LIMIT_SECONDS=0
ASR_USER_DAILY_HARD_LIMIT_SECONDS=0
ASR_ECONOMY_FALLBACK_ENABLED=false
CLOUD_ASR_TIMEOUT_SECONDS=1800
CLOUD_ASR_HTTP_TIMEOUT_SECONDS=30
CLOUD_ASR_MAX_FILE_BYTES=268435456
# signed_url keeps audio only on this server. aliyun_temp uses Bailian's
# development-oriented temporary storage, which expires automatically within 48h.
CLOUD_ASR_AUDIO_DELIVERY=signed_url
CLOUD_ASR_UPLOAD_TIMEOUT_SECONDS=300
ASR_QWEN_PRICE_PER_SECOND=0.00022
ASR_PARAFORMER_PRICE_PER_SECOND=0.00008
ASR_USAGE_DB_PATH=./var/cache/cloud-usage.db
AUDIO_SIGNING_SECRET=
PUBLIC_BASE_URL=https://caption.example.com
TEMP_AUDIO_TTL_SECONDS=1800
# Live subtitle results and recognition caches; downloads on a user's device are unaffected.
TRANSCRIPT_RETENTION_DAYS=1

# One local small/int8 model is loaded on demand and kept single-concurrency.
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cpu
ASR_CPU_THREADS=3
ASR_FAST_BEAM_SIZE=3
ASR_TIMEOUT_SECONDS=1800
ASR_TIMEOUT_PER_AUDIO_SECOND=0.5
ASR_BALANCED_BEAM_SIZE=3
ASR_BALANCED_VAD_FILTER=true
ASR_BALANCED_CONDITION_ON_PREVIOUS_TEXT=true
ASR_BALANCED_TIMEOUT_SECONDS=2400
ASR_BALANCED_TIMEOUT_PER_AUDIO_SECOND=1.0
ASR_ACCURATE_MODEL=small
ASR_ACCURATE_COMPUTE_TYPE=int8
ASR_ACCURATE_DEVICE=cpu
ASR_ACCURATE_CPU_THREADS=3
ASR_ACCURATE_BEAM_SIZE=5
ASR_ACCURATE_VAD_FILTER=true
ASR_ACCURATE_CONDITION_ON_PREVIOUS_TEXT=true
ASR_ACCURATE_TIMEOUT_SECONDS=3600
ASR_ACCURATE_TIMEOUT_PER_AUDIO_SECOND=1.5
ASR_MAX_TIMEOUT_SECONDS=7200
ASR_DOWNLOAD_TIMEOUT_SECONDS=300
ASR_MAX_AUDIO_SECONDS=3600
ASR_PROMPT_MAX_CHARS=300
ASR_VAD_THRESHOLD=0.45
ASR_VAD_MIN_SILENCE_MS=700
ASR_VAD_SPEECH_PAD_MS=300
ASR_LOW_LOGPROB_THRESHOLD=-1.0
ASR_RETRY_REPETITION_RATIO=0.25
ASR_RETRY_LOW_CONFIDENCE_RATIO=0.65
# Avoid doubling long jobs; 0 removes the duration cap.
ASR_CONTEXT_RETRY_MAX_AUDIO_SECONDS=600
ASR_CONTEXT_RETRY_ENABLED=true
BILI_MAX_DOWNLOAD_BYTES=1000000000
UPLOAD_MAX_BYTES=536870912
PUBLIC_UPLOAD_MAX_BYTES=536870912
UPLOAD_STAGING_MAX_BYTES=2147483648
MEDIA_ARTIFACT_DIR=./var/tmp/media-artifacts
MEDIA_MAX_BYTES=1000000000
MEDIA_STAGING_MAX_BYTES=8000000000
MEDIA_ARTIFACT_TTL_SECONDS=3600
MEDIA_MAX_DURATION_SECONDS=21600
MEDIA_FRAGMENT_CONCURRENCY=2
ASR_CONCURRENCY_LIMIT=1
ASR_QUEUE_WAIT_SECONDS=1800
# Try the local model cache first. Disable network fallback on preseeded production hosts.
ASR_MODEL_DOWNLOAD_ENABLED=true
# Exit the whole ASR child after this many idle seconds; 0 keeps it resident.
ASR_MODEL_IDLE_SECONDS=900
# Set false to retain the worker and only unload its model (rollback behavior).
ASR_WORKER_EXIT_ON_IDLE=true
ASR_TMP_MAX_AGE_SECONDS=86400
ASR_VAD_FILTER=true
ASR_CONDITION_ON_PREVIOUS_TEXT=false
ASR_PERSISTENT_WORKER=true
ASR_PREWARM=false
ASR_PREWARM_QUALITY=balanced
ASR_AUDIO_QUALITY=best
ASR_AUDIO_FILTER=
OCR_TIMEOUT_SECONDS=1800
OCR_SAMPLE_FPS=1.5
OCR_CROP_TOP_RATIO=0.45
OCR_MIN_CONFIDENCE=0.55
OCR_CPU_THREADS=1
OCR_MAX_FRAMES=12000
MIN_FREE_DISK_BYTES=2147483648
MIN_FREE_DISK_RATIO=0.05
PROCESS_ERROR_OUTPUT_BYTES=16384
ASR_TMP_DIR=./var/tmp
ASR_MODEL_DIR=./var/models
ASR_CACHE_DIR=./var/cache
RESULT_CACHE_DIR=./var/cache/results
# Cannot exceed TRANSCRIPT_RETENTION_DAYS; reads do not extend this lifetime.
RESULT_CACHE_TTL_SECONDS=86400
RESULT_CACHE_MAX_ITEMS=100
JOB_QUEUE_MAX_PENDING=4
JOB_WORKER_COUNT=2
JOB_RESULT_TTL_SECONDS=86400
JOB_MAX_RECORDS=100
JOB_STATE_DB_PATH=./var/cache/jobs.db
LEGACY_WAIT_TIMEOUT_SECONDS=1200
DOUYIN_ENABLED=true
DOUYIN_COOKIE_STATE_PATH=./var/douyin/cookies.json
DOUYIN_COOKIE_TTL_SECONDS=1800
DOUYIN_DETAIL_CACHE_TTL_SECONDS=600
DOUYIN_BROWSER_WAIT_MS=6000
DOUYIN_BROWSER_LOCK_TIMEOUT_SECONDS=90
DOUYIN_MAX_DOWNLOAD_BYTES=1000000000
PLAYWRIGHT_BROWSERS_PATH=./var/playwright
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
OMP_NUM_THREADS=3
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
